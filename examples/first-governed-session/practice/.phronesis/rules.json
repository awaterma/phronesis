    {
      "id": "no-tutorial-blocked-marker",
      "phase": "pre",
      "priority": 10,
      "audit": true,
      "conditions": [
        {
          "predicate": "new_content_contains",
          "args": ["TUTORIAL-BLOCKED-MARKER"]
