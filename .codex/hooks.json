{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook PostCompact",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook PostToolUse",
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch)$"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook PreCompact",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook PreToolUse",
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch)$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook SessionStart",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook Stop",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook SubagentStart",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook SubagentStop",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "phr-mcp codex-hook UserPromptSubmit",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}