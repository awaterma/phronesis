/target
**/*.bak
**/.phronesis/log.jsonl
**/.phronesis/log.jsonl.1
**/.phronesis/rules.json.bak
**/.phronesis/journey/
**/.phronesis/graph.jsonl
**/.phronesis/graph.index

# Local agent worktrees
.worktrees/

# Private cross-project docs — keep local, never publish
docs/specs/*-migration-map.md
docs/specs/PLAN-v0.11-hardening.md

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Local IDE / agent configs (not part of the project)
.claude/
.crush/
.gemini/
.obsidian/
.vscode/
.mcp.json

# Local rules cache produced when running phr-mcp here
.phronesis/*
.phronesis/log.jsonl
.phronesis/log.jsonl.1
.phronesis/rules.json.bak
!.phronesis/wiki/
!.phronesis/wiki/**
!.phronesis/journey.json
!.phronesis/confidence.json
!.phronesis/bugs.json
!.phronesis/toolchains.json
!.phronesis/predicates/
!.phronesis/predicates/**
!.phronesis/context.json
!.phronesis/kernel.md
!.phronesis/nudges/
!.phronesis/nudges/**

# Point-in-time project evaluations. Generated from local audit/graph/stats
# state, so they go stale the moment the tree moves — keep them local rather
# than versioning a snapshot that will disagree with the repo it describes.
docs/phronesis-evaluation-*.html
