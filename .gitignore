/target
**/Cargo.lock
**/*.bak
**/.phronesis/log.jsonl
**/.phronesis/log.jsonl.1
**/.phronesis/rules.json.bak

# Private cross-project docs — keep local, never publish
docs/specs/*-migration-map.md
docs/specs/PLAN-v0.11-hardening.md

# Local IDE / agent configs (not part of the project)
.claude/
.crush/
.gemini/
.vscode/
.mcp.json

# Local rules cache produced when running phr-mcp here
.phronesis/*
.phronesis/log.jsonl
.phronesis/log.jsonl.1
.phronesis/rules.json.bak
!.phronesis/wiki/
!.phronesis/wiki/**
